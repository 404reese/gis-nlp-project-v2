# Copy to .env.local (Vite auto-loads it). All frontend env vars must be prefixed VITE_.

# MapTiler API key for nicer vector basemaps. Get a free key at
# https://cloud.maptiler.com/account/keys/  -> free tier.
# If left blank, the app falls back to the free MapLibre demo style (no key needed).
VITE_MAPTILER_KEY=

# Backend + tile server
VITE_API_BASE=http://localhost:8000
VITE_MARTIN_URL=http://localhost:3001
