# Copy to .env and adjust. Root-level env for Docker Compose + backend ETL.

# --- Postgres / PostGIS (docker compose) ---
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo
POSTGRES_DB=geo
POSTGRES_PORT=5433   # host port; 5433 avoids clashing with a native PostgreSQL on 5432
MARTIN_PORT=3001

# --- Backend connection strings ---
# App uses the owner role for reads that need all schemas; the NL engine uses geo_readonly.
DATABASE_URL=postgresql+asyncpg://geo:geo@localhost:5433/geo
DATABASE_URL_READONLY=postgresql+asyncpg://geo_readonly:geo_readonly@localhost:5433/geo

# Where the frontend should fetch vector tiles from Martin
MARTIN_URL=http://localhost:3001

# --- Existing services (unchanged) ---
GROQ_API_KEY=
MONGODB_URI=mongodb://localhost:27017
